{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "cloudflare/worker.ts",
  "name": "dams-meetup",
  "account_id": "f1dc30bb93206c310ab2b840baceb857",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    { "binding": "ACTIVITY_DB", "database_name": "dams-meetup-15" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ACTIVITY_UPDATES", "class_name": "ActivityUpdates" }
    ]
  },
  "migrations": [
    { "tag": "activity-updates-v1", "new_sqlite_classes": ["ActivityUpdates"] }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "dams-meetup"
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "live.nl-dams.com", "custom_domain": true }
  ]
}
